{
  "references": [{"path": "./tsconfig.build.json"}],
  "exclude": ["src"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "xastscript",
    "lib": ["esnext"],
    "module": "nodenext",
    "noEmit": true,
    "strict": true,
    "target": "esnext",
    "verbatimModuleSyntax": true
  }
}
